---
import Simulator from "./Simulator.astro";
import type { Dictionary, Locale } from "../i18n";

interface Props {
  readonly t: Dictionary;
  readonly locale: Locale;
}
const { t, locale } = Astro.props;
// Emphasis on the question after the comma; a title without comma renders plain (no hard-coded punctuation).
const comma = t.hero.title.indexOf(",");
const before = comma < 0 ? t.hero.title : t.hero.title.slice(0, comma);
const after = comma < 0 ? null : t.hero.title.slice(comma + 1).trim();
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-field" data-field aria-hidden="true">
    <div class="poster"></div>
    <canvas></canvas>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="signal"><i></i>{t.hero.eyebrow}</p>
      <h1 id="hero-title">{after === null ? before : <Fragment>{before},{" "}<em>{after}</em></Fragment>}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#methode">{t.hero.cta} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="#offres">{t.hero.secondary}</a>
      </div>
      <p class="note">{t.hero.note}</p>
    </div>
    <Simulator t={t} locale={locale} />
  </div>
</section>

<script>
  import "../scripts/field";
</script>
