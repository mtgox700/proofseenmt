// Schéma de la marketplace Proofseen — sprint C1 (2026-10-05), révisé après revue base de données le même jour.
//
// Principes portés par le schéma lui-même, pas laissés à la discipline du code :
// - l'argent est en centimes entiers, la devise explicite et prise dans une liste fermée ; jamais de flottant ;
// - aucune colonne de score ou de classement de personnes (AI Act : la recherche filtre, elle ne classe pas) ;
// - aucun nom de tiers : le client final d'une mission vérifiée est un type en vocabulaire fermé ; son nom n'est gardé
//   pour publication que si le client lui-même l'a autorisé en confirmant la mission (C13) ;
// - la suppression d'un utilisateur emporte ses données par cascade (RGPD), sauf ce que la loi impose de garder
//   (contrats, paiements, factures), qui est détaché de la personne mais garde une copie figée de l'identité légale
//   des parties : une facture sans émetteur ni destinataire ne vaut rien ;
// - un avis, un paiement, une facture n'existent pas sans contrat.
//
// Les contraintes que Prisma ne sait pas exprimer (CHECK, déclencheurs) sont dans la migration SQL, à la suite du code
// généré. Les vocabulaires fermés reprennent à l'identique ceux de `@proofseen/core` et `@proofseen/profiles` ; un test
// vérifie qu'ils ne divergent pas.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Vocabulaires fermés ────────────────────────────────────────────────────────────────────────────────────────────
// Énumérations natives : Postgres ajoute une valeur sans réécrire la table. Ces vocabulaires grandissent, ils ne
// rétrécissent pas ; c'est la suppression d'une valeur qui coûterait cher, et elle n'est pas prévue.

/// Identique à `CLIENT_KINDS` de `@proofseen/profiles`.
enum ClientKind {
  startup
  scaleup
  grand_groupe
  eti
  pme
  secteur_public
  editeur_logiciel
  esn
  association
}

/// Identique à `EVIDENCE_KINDS` de `@proofseen/profiles`.
enum EvidenceKind {
  facture
  contrat
  attestation_client
  acces_depot
  livrable_public
  client_confirmation // confirmée sur Proofseen par l'entreprise cliente (compte ou lien signé)
  paid_on_platform    // mission contractée et payée sur Proofseen
}

/// Identique au statut de disponibilité de `@proofseen/profiles`.
enum AvailabilityStatus {
  available
  available_from
  unavailable
}

/// Identique aux méthodes de preuve de `@proofseen/core`.
enum ProofMethod {
  well_known_file
  meta_tag
  dns_txt
  profile_token
}

enum ProfileVisibility {
  named        // nom réel affiché
  pseudonymous // faits publiés, nom masqué, contact par la plateforme
  private      // rien de public
}

enum WorkMode {
  onsite
  hybrid
  remote
}

enum MemberRole {
  owner
  admin
  member
}

/// État d'un SIRET dans le répertoire officiel des entreprises (API publique Recherche d'entreprises), à la date du contrôle.
enum RegistryStatus {
  active    // établissement et entreprise actifs
  ceased    // établissement ou entreprise fermés
  not_found // inconnu du répertoire
  mismatch  // actif, mais sous un autre nom que la raison sociale déclarée : le SIRET n'est pas celui de cette partie
}

enum JobPostStatus {
  draft
  open
  closed
}

enum ApplicationStatus {
  submitted
  shortlisted
  declined
  withdrawn
  hired
}

/// Le freelance accepte ou refuse le contact. Tant qu'il n'a pas accepté, l'entreprise ne peut plus écrire et ne sait
/// pas qui il est (identité partagée après accord, avant tout engagement : art. 1112-1 C. civ.).
enum ConversationStatus {
  pending
  accepted
  declined
  /// Fermé après accord, par l'une ou l'autre partie, ou quand la candidature d'origine est retirée ou déclinée.
  closed
}

enum QuoteStatus {
  draft
  sent
  accepted
  declined
  superseded
  closed // son contrat est terminé ou annulé : le fil peut accueillir un nouveau devis
}

/// Forfait : un montant, payé puis versé une fois. Régie : un plafond de jours, facturé chaque mois sur relevé validé.
enum ContractBilling {
  fixed
  monthly
}

/// Relevé mensuel d'un contrat en régie : déclaré par le freelance, validé ou refusé par l'entreprise.
enum TimesheetStatus {
  submitted
  approved
  rejected
}

enum ContractStatus {
  pending_signatures
  active
  completed
  cancelled
}

/// Les états réels d'un paiement Stripe, échecs compris : un statut manquant se retrouve un jour forcé dans un autre.
enum PaymentStatus {
  pending
  held      // fonds bloqués jusqu'à validation de la prestation
  releasing // réservé pour un versement en cours : aucun remboursement ni second versement ne peut le prendre
  released
  refunding // réservé pour un remboursement en cours
  refunded
  disputed
  failed
  canceled
}

// ─── Personnes et organisations ─────────────────────────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Identifiant Clerk : l'authentification vit chez Clerk, jamais de mot de passe ici.
  clerkId     String   @unique
  /// Toujours en minuscules (contrainte en base) : « A@x.fr » et « a@x.fr » sont la même personne.
  email       String   @unique
  displayName String
  /// Langue des e-mails envoyés à la personne.
  lang        String   @default("fr") @db.Char(2)
  /// Suspendu par un opérateur (C19) : plus d'accès aux espaces de l'application, contenus publics masqués. Le motif est
  /// montré à la personne ; qui a suspendu, et quand, est au journal des opérateurs.
  suspendedAt      DateTime? @db.Timestamptz(3)
  suspensionReason String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  freelanceProfile        FreelanceProfile?
  memberships             Membership[]
  sentMessages            Message[]
  reviewsWritten          Review[]                 @relation("ReviewAuthor")
  jobPostsAuthored        JobPost[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  missionAlerts           MissionAlert[]
  feedback                Feedback[]
  timesheetDecisions      Timesheet[]              @relation("TimesheetDecider")
  contractApprovals       ContractApproval[]
  apiKeysCreated          ApiKey[]
  measurementRequests     MeasurementRequest[]
  freelanceListsCreated   FreelanceList[]          @relation("FreelanceListCreator")
  freelanceListItemsAdded FreelanceListItem[]      @relation("FreelanceListItemAdder")
  freelanceListReactions  FreelanceListReaction[]
  missionConfirmationsDecided MissionConfirmationRequest[] @relation("MissionConfirmationDecider")
  storedFiles             StoredFile[]
  applicationsRead        Application[]            @relation("ApplicationReader")
  savedMissions           SavedMission[]
  companyFollows          CompanyFollow[]
  missionInvitationsSent  MissionInvitation[]
  missionTemplatesCreated MissionTemplate[]
  conversationReads       ConversationRead[]
  appNotifications        AppNotification[]
  messageDigest           MessageDigest?
  pushSubscriptions       PushSubscription[]
}

model Organisation {
  id             String     @id @default(uuid(7)) @db.Uuid
  name           String
  kind           ClientKind
  /// Identité légale, nécessaire pour facturer. Copiée dans chaque contrat et chaque facture au moment de leur création.
  /// Un SIRET n'appartient qu'à une seule entreprise de la plateforme.
  siret          String?    @unique
  vatNumber      String?
  billingAddress Json?
  /// Contrôle du SIRET au répertoire officiel ; remis à zéro quand le SIRET change.
  registryStatus      RegistryStatus?
  registryCheckedAt   DateTime?       @db.Timestamptz(3)
  /// Nom officiel au répertoire, comparé à la raison sociale déclarée.
  registryName        String?
  /// Dernière tentative, réussie ou non : un SIRET dont le contrôle échoue ne bloque pas la file des autres.
  registryAttemptedAt DateTime?       @db.Timestamptz(3)
  /// Nombre de validations distinctes exigées avant de valider une prestation (et donc de déclencher le versement) : 1 ou 2.
  approvalLevels Int        @default(1)
  /// Page publique de l'entreprise (C16), seulement si elle l'a activée : `publicSince` nul = aucune page. L'adresse
  /// reste la même si l'entreprise la désactive puis la réactive.
  publicSlug        String?   @unique
  publicName        String?
  publicDescription String?
  publicWebsite     String?
  publicCity        String?
  publicSince       DateTime? @db.Timestamptz(3)
  /// Page publique masquée par un opérateur (C19), avec son motif, montré aux membres de l'entreprise.
  moderatedAt       DateTime? @db.Timestamptz(3)
  moderationReason  String?
  /// Entreprise entière masquée par un opérateur (revue de sécurité vague 3, M5), avec son motif : sa page publique,
  /// toutes ses missions et ses clés d'API sortent d'usage, qu'un membre soit actif ou non.
  suspendedAt       DateTime? @db.Timestamptz(3)
  suspensionReason  String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  members       Membership[]
  jobPosts      JobPost[]
  conversations Conversation[]
  contracts     Contract[]
  apiKeys       ApiKey[]
  freelanceLists FreelanceList[]
  missionConfirmations MissionConfirmationRequest[]
  missionsConfirmed    VerifiedMission[]
  missionTemplates     MissionTemplate[]
  followers            CompanyFollow[]
  statDays             OrganisationStatDay[]
}

model Membership {
  organisationId String     @db.Uuid
  userId         String     @db.Uuid
  role           MemberRole @default(member)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organisationId, userId])
  @@index([userId])
}

// ─── Profil freelance ───────────────────────────────────────────────────────────────────────────────────────────────

model FreelanceProfile {
  id             String             @id @default(uuid(7)) @db.Uuid
  userId         String             @unique @db.Uuid
  /// Référence publique (FR-XXXXX), tirée au hasard et jamais dérivée du nom.
  reference      String             @unique
  /// Adresse publique du profil ; obligatoire dès que le profil n'est plus privé (contrainte en base).
  slug           String?            @unique
  visibility     ProfileVisibility  @default(private)
  /// Facultatifs tant que le profil est un brouillon privé ; obligatoires pour le publier (contrainte en base).
  headline       String?
  summary        String?
  city           String?
  /// Forme normalisée de la ville, pour que « Paris » et « paris » soient le même filtre.
  cityKey        String?
  workMode       WorkMode
  /// TJM en centimes. Facultatif : un freelance peut ne pas l'afficher.
  dailyRateCents Int?
  currency       String             @default("EUR") @db.Char(3)
  availability   AvailabilityStatus @default(available)
  availableFrom  DateTime?          @db.Date
  /// Dernière déclaration ou confirmation de la disponibilité par le freelance : affichée sur la page publique ; au-delà
  /// de 30 jours, les filtres de disponibilité de la recherche ne retiennent plus le profil.
  availabilityAt DateTime           @default(now()) @db.Timestamptz(3)
  /// Photo du profil : publique seulement sur un profil nominatif.
  photoFileId    String?            @unique @db.Uuid
  /// Profil masqué par un opérateur (C19) : absent de toute page publique, avec son motif, montré au freelance.
  moderatedAt      DateTime?        @db.Timestamptz(3)
  moderationReason String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  billing        BillingIdentity?
  skills         FreelanceSkill[]
  ownedUrls      OwnedUrl[]
  missions       VerifiedMission[]
  applications   Application[]
  conversations  Conversation[]
  contracts      Contract[]
  reviews        Review[]          @relation("ReviewTarget")
  waves          Wave[]
  measurements   MeasurementRequest[]
  vigilance      VigilanceAttestation?
  listedIn       FreelanceListItem[]
  missionConfirmations MissionConfirmationRequest[]
  photo          StoredFile?       @relation("ProfilePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  experiences    ProfileExperience[]
  educations     ProfileEducation[]
  certifications ProfileCertification[]
  languages      ProfileLanguage[]
  portfolio      PortfolioItem[]
  importDraft    ProfileImportDraft?
  missionInvitations   MissionInvitation[]
  statDays       ProfileStatDay[]
  statKeywords   ProfileStatKeyword[]
  statSeen       ProfileStatSeen[]

  /// Recherche publique : l'ordre est un identifiant stable, jamais un score de personne.
  @@index([workMode, availability, id], where: raw("\"visibility\" <> 'private'"), map: "FreelanceProfile_public_search_idx")
  @@index([cityKey, workMode, id], where: raw("\"visibility\" <> 'private'"), map: "FreelanceProfile_public_city_idx")
}

/// Identité de facturation du freelance. Privée : elle ne sert qu'à émettre des factures, jamais à un profil public.
model BillingIdentity {
  id        String   @id @default(uuid(7)) @db.Uuid
  profileId String   @unique @db.Uuid
  legalName String
  /// Un SIRET n'appartient qu'à un seul freelance de la plateforme.
  siret     String?  @unique
  vatNumber String?
  address   Json
  /// Taux de TVA facturé par le freelance, en points de base : 0 en franchise (art. 293 B du CGI), 2000 au taux normal.
  vatRateBp Int      @default(0)
  /// Compte Stripe Connect qui reçoit les versements. Nul tant que le freelance n'a pas terminé l'inscription chez Stripe.
  stripeAccountId String? @unique
  /// Date à laquelle Stripe a confirmé que le compte peut recevoir des versements ; aucun versement avant.
  payoutsEnabledAt DateTime? @db.Timestamptz(3)
  /// Contrôle du SIRET au répertoire officiel ; remis à zéro quand le SIRET change.
  registryStatus      RegistryStatus?
  registryCheckedAt   DateTime?       @db.Timestamptz(3)
  registryName        String?
  registryAttemptedAt DateTime?       @db.Timestamptz(3)
  /// Acceptation expresse du mandat de facturation (art. 289 I-2 du CGI) : Proofseen émet les factures de mission au nom
  /// et pour le compte du freelance. Aucun contrat ne naît sans elle.
  invoicingMandateAt  DateTime?       @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

/// Attestation de vigilance URSSAF du freelance (art. L8222-1 du Code du travail) : l'entreprise cliente doit l'obtenir
/// tous les six mois pour une prestation d'au moins 5 000 € HT. Une seule attestation courante par profil ; une nouvelle
/// remplace l'ancienne. Le code de sécurité permet à un opérateur de la vérifier à la main sur le site de l'URSSAF.
model VigilanceAttestation {
  id           String    @id @default(uuid(7)) @db.Uuid
  profileId    String    @unique @db.Uuid
  issuedOn     DateTime  @db.Date
  securityCode String
  /// Posée par un opérateur après vérification sur le site de l'URSSAF ; seule une attestation vérifiée est affichée.
  verifiedAt   DateTime? @db.Timestamptz(3)
  /// Rappel d'échéance envoyé : une seule fois par attestation.
  remindedAt   DateTime? @db.Timestamptz(3)
  /// Refusée par un opérateur (C19), avec son motif : le freelance doit en déclarer une autre.
  rejectedAt      DateTime? @db.Timestamptz(3)
  rejectionReason String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([issuedOn])
}

model Skill {
  id    String @id @default(uuid(7)) @db.Uuid
  /// Forme normalisée (minuscules, sans accents) : « TypeScript » et « typescript » sont la même compétence.
  key   String @unique
  label String

  freelancers FreelanceSkill[]
  jobPosts    JobPostSkill[]
}

model FreelanceSkill {
  profileId String @db.Uuid
  skillId   String @db.Uuid

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  /// Couvrant : la recherche par compétence obtient le profil sans relire la table.
  @@index([skillId, profileId])
}

model OwnedUrl {
  id          String      @id @default(uuid(7)) @db.Uuid
  profileId   String      @db.Uuid
  url         String
  /// Forme normalisée (minuscules, sans barre finale) : `/a` et `/a/` sont la même adresse.
  urlKey      String
  proofMethod ProofMethod
  /// Date de la preuve de possession. Nulle tant que rien n'est prouvé : aucune mesure ne part sans elle.
  verifiedAt  DateTime?   @db.Timestamptz(3)
  /// Dernière relecture de la preuve, réussie ou non : une preuve se revérifie, elle ne vaut pas pour toujours.
  checkedAt   DateTime?   @db.Timestamptz(3)
  /// Début des échecs de relecture en cours. La preuve tient pendant un délai de grâce, puis tombe.
  failedAt    DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, urlKey])
  /// Une adresse ne peut être **prouvée** que par un seul profil : deux personnes ne possèdent pas la même page.
  @@unique([urlKey], where: raw("\"verifiedAt\" IS NOT NULL"), map: "OwnedUrl_verified_uq")
}

/// Une mission passée, vérifiée par Proofseen. Le client n'est nommé que s'il l'a lui-même accepté en confirmant ;
/// sinon, seulement son type. Jamais déclarée par le freelance seul : elle naît d'une confirmation du client ou d'un
/// contrat payé sur la plateforme.
model VerifiedMission {
  id             String       @id @default(uuid(7)) @db.Uuid
  profileId      String       @db.Uuid
  role           String
  clientKind     ClientKind
  durationMonths Int
  summary        String
  evidenceKind   EvidenceKind
  verifiedAt     DateTime     @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  /// Nom du client, publié seulement si le client l'a autorisé en confirmant (case décochée par défaut).
  clientName     String?
  /// Demande de confirmation d'origine : une demande ne crée jamais deux missions.
  confirmationId String?      @unique @db.Uuid
  /// Contrat payé d'origine : un contrat ne crée jamais deux missions.
  contractId     String?      @unique @db.Uuid
  /// Qui a confirmé, pour contrôle interne, jamais publié : l'entreprise inscrite, ou le domaine de l'adresse du contact.
  confirmedByOrganisationId String? @db.Uuid
  confirmedByDomain         String?

  profile        FreelanceProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  confirmation   MissionConfirmationRequest? @relation(fields: [confirmationId], references: [id], onDelete: SetNull)
  contract       Contract?                   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  confirmedByOrg Organisation?               @relation(fields: [confirmedByOrganisationId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([confirmedByOrganisationId], where: raw("\"confirmedByOrganisationId\" IS NOT NULL"), map: "VerifiedMission_confirmedByOrganisationId_idx")
}

enum MissionConfirmationStatus {
  pending   // en attente de la réponse du client (expire au bout de 30 jours sans rien publier)
  confirmed // confirmée : une mission vérifiée est née
  refused   // refusée par le client : rien n'est publié
}

/// Demande de confirmation d'une mission passée, adressée par le freelance à son client : à une entreprise inscrite
/// (SIRET reconnu), dont les propriétaires et administrateurs décident, ou à un contact par e-mail, qui décide sans
/// compte par un lien signé, à usage unique et qui expire. Seule l'empreinte du jeton est gardée.
model MissionConfirmationRequest {
  id              String                    @id @default(uuid(7)) @db.Uuid
  profileId       String                    @db.Uuid
  role            String
  /// Nom du client tel que déclaré : montré au client seulement, publié seulement s'il l'autorise.
  clientName      String
  clientSiret     String?                   @db.Char(14)
  clientKind      ClientKind
  /// Exactement une cible : l'entreprise inscrite, ou l'adresse du contact (en minuscules).
  organisationId  String?                   @db.Uuid
  contactEmail    String?
  startedOn       DateTime                  @db.Date
  endedOn         DateTime                  @db.Date
  summary         String
  /// Langue de l'e-mail envoyé au contact.
  lang            String                    @default("fr") @db.Char(2)
  /// SHA-256 du jeton du lien ; nul pour une demande adressée à une entreprise inscrite.
  tokenHash       String?                   @unique
  status          MissionConfirmationStatus @default(pending)
  expiresAt       DateTime                  @db.Timestamptz(3)
  decidedAt       DateTime?                 @db.Timestamptz(3)
  /// Membre de l'entreprise qui a décidé ; nul pour un contact sans compte, ou s'il a effacé son compte.
  decidedByUserId String?                   @db.Uuid
  /// Le client autorise l'affichage du nom de son entreprise sur le profil public.
  showClientName  Boolean                   @default(false)
  /// File d'envoi de l'e-mail au contact : la ligne elle-même, réessayée comme les notifications.
  emailSendAfter  DateTime?                 @db.Timestamptz(3)
  emailSentAt     DateTime?                 @db.Timestamptz(3)
  emailAttempts   Int                       @default(0)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)

  profile         FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  organisation    Organisation?    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  decidedBy       User?            @relation("MissionConfirmationDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  verifiedMission VerifiedMission?

  @@index([profileId, createdAt(sort: Desc)])
  @@index([organisationId, status], where: raw("\"organisationId\" IS NOT NULL"), map: "MissionConfirmationRequest_organisation_idx")
  @@index([emailSendAfter, id], where: raw("\"emailSentAt\" IS NULL AND \"contactEmail\" IS NOT NULL AND \"status\" = 'pending'"), map: "MissionConfirmationRequest_mail_idx")
  @@index([contactEmail], where: raw("\"contactEmail\" IS NOT NULL"), map: "MissionConfirmationRequest_contactEmail_idx")
  @@index([decidedByUserId], where: raw("\"decidedByUserId\" IS NOT NULL"), map: "MissionConfirmationRequest_decidedByUserId_idx")
  @@index([expiresAt])
}

// ─── Missions publiées et candidatures ──────────────────────────────────────────────────────────────────────────────

model JobPost {
  id                String        @id @default(uuid(7)) @db.Uuid
  organisationId    String        @db.Uuid
  authorUserId      String?       @db.Uuid
  title             String
  description       String
  durationMonths    Int?
  dailyRateMinCents Int?
  dailyRateMaxCents Int?
  currency          String        @db.Char(3)
  city              String?
  /// Forme normalisée de la ville : le filtre compare des clés, jamais un motif où « % » serait un joker.
  cityKey           String?
  workMode          WorkMode
  /// Trois questions au plus, posées à chaque candidat ; ses réponses accompagnent sa candidature.
  questions         String[]      @default([])
  /// Les libellés des compétences, à la suite : la recherche plein texte les lit avec l'intitulé et la description.
  skillsText        String        @default("")
  status            JobPostStatus @default(draft)
  publishedAt       DateTime?     @db.Timestamptz(3)
  closedAt          DateTime?     @db.Timestamptz(3)
  /// Mission masquée par un opérateur (C19) : absente de toute page publique, avec son motif, montré à l'entreprise.
  moderatedAt       DateTime?     @db.Timestamptz(3)
  moderationReason  String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// L'auteur peut quitter l'entreprise ou supprimer son compte : la mission reste à l'entreprise.
  author       User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  skills       JobPostSkill[]
  applications Application[]
  savedBy      SavedMission[]
  invitations  MissionInvitation[]

  /// Les missions ouvertes, des plus récentes aux plus anciennes, avec l'identifiant pour paginer sans ex aequo.
  @@index([publishedAt(sort: Desc), id(sort: Desc)], where: raw("\"status\" = 'open'"), map: "JobPost_open_recent_idx")
  @@index([workMode, publishedAt(sort: Desc), id(sort: Desc)], where: raw("\"status\" = 'open'"), map: "JobPost_open_workmode_recent_idx")
  @@index([cityKey, publishedAt(sort: Desc), id(sort: Desc)], where: raw("\"status\" = 'open'"), map: "JobPost_open_city_recent_idx")
  @@index([organisationId, createdAt(sort: Desc)])
  @@index([authorUserId], where: raw("\"authorUserId\" IS NOT NULL"), map: "JobPost_authorUserId_idx")
}

model JobPostSkill {
  jobPostId String @db.Uuid
  skillId   String @db.Uuid

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobPostId, skillId])
  @@index([skillId, jobPostId])
}

model Application {
  id        String            @id @default(uuid(7)) @db.Uuid
  jobPostId String            @db.Uuid
  profileId String            @db.Uuid
  coverNote String
  /// Réponses aux questions de la mission, dans leur ordre.
  answers   String[]          @default([])
  status    ApplicationStatus @default(submitted)
  /// Première ouverture de la candidature par un membre de l'entreprise : le freelance voit la date, jamais le nom.
  readAt       DateTime?      @db.Timestamptz(3)
  readByUserId String?        @db.Uuid
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  jobPost      JobPost          @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  profile      FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  conversation Conversation?
  /// Privé : sert à l'entreprise seule. Le lecteur peut quitter l'entreprise ou effacer son compte.
  readBy       User?            @relation("ApplicationReader", fields: [readByUserId], references: [id], onDelete: SetNull)

  /// Une seule candidature par freelance et par mission.
  @@unique([jobPostId, profileId])
  @@index([jobPostId, status, createdAt(sort: Desc)])
  @@index([profileId, createdAt(sort: Desc)])
  @@index([readByUserId], where: raw("\"readByUserId\" IS NOT NULL"), map: "Application_readByUserId_idx")
}

// ─── Messagerie ─────────────────────────────────────────────────────────────────────────────────────────────────────

/// Le contact entre une entreprise et un freelance passe par la plateforme : c'est le point où la commission se gagne.
model Conversation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @db.Uuid
  profileId      String   @db.Uuid
  applicationId  String?  @unique @db.Uuid
  /// Fil ouvert sans candidature. Fixé à la création : supprimer une mission détache sa candidature du fil, ce qui ne
  /// doit pas le transformer en fil direct (il heurterait l'unicité des fils directs et bloquerait la suppression).
  direct         Boolean            @default(false)
  /// Un fil né d'une candidature est accepté d'emblée : c'est le freelance qui a pris contact.
  status         ConversationStatus @default(pending)
  decidedAt      DateTime?          @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  /// Mis à jour par un déclencheur à chaque message, dans la même transaction.
  lastMessageAt  DateTime @default(now()) @db.Timestamptz(3)

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  profile      FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  application  Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  messages     Message[]
  quotes       Quote[]
  reads        ConversationRead[]
  review       ContactReview?

  @@index([profileId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([organisationId, lastMessageAt(sort: Desc), id(sort: Desc)])
  /// Un seul fil direct par entreprise et par freelance : un double clic n'ouvre pas deux conversations.
  @@unique([organisationId, profileId], where: raw("\"direct\""), map: "Conversation_direct_uq")
}

model Message {
  id              String   @id @default(uuid(7)) @db.Uuid
  conversationId  String   @db.Uuid
  /// Nul si l'expéditeur a supprimé son compte : le message reste lisible pour l'autre partie, sans auteur identifiable.
  senderUserId    String?  @db.Uuid
  body            String
  /// Coordonnées détectées dans le message : signalé, jamais censuré en silence.
  containsContact Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments  StoredFile[]

  @@index([conversationId, createdAt, id])
  /// Sans lui, supprimer un compte parcourrait toute la table des messages pour effacer son nom d'expéditeur.
  @@index([senderUserId], where: raw("\"senderUserId\" IS NOT NULL"), map: "Message_senderUserId_idx")
}

// ─── Devis, contrat, paiement, facture, avis ────────────────────────────────────────────────────────────────────────

/// Les parties d'un devis sont celles de sa conversation : les recopier ici permettrait un devis au nom d'un autre.
model Quote {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @db.Uuid
  dailyRateCents Int
  days           Int
  totalCents     Int
  currency       String      @db.Char(3)
  billing        ContractBilling @default(fixed)
  status         QuoteStatus @default(draft)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contract     Contract?

  @@index([conversationId])
  /// Un seul devis accepté par conversation.
  @@unique([conversationId], where: raw("\"status\" = 'accepted'"), map: "Quote_one_accepted_uq")
}

/// Un contrat tient seul : il porte ses propres conditions et une copie figée de l'identité légale des parties. Sans
/// cela, supprimer un compte (RGPD) effacerait ses devis, ce qu'un contrat signé interdirait, et une facture conservée
/// n'aurait plus ni émetteur ni destinataire.
model Contract {
  id                    String         @id @default(uuid(7)) @db.Uuid
  /// Devis d'origine, détaché s'il disparaît : le contrat garde ses conditions recopiées ci-dessous.
  quoteId               String?        @unique @db.Uuid
  /// Nuls seulement après suppression d'un compte ; obligatoires à la création (déclencheur, jamais une contrainte CHECK,
  /// qui ferait échouer la suppression).
  organisationId        String?        @db.Uuid
  profileId             String?        @db.Uuid
  dailyRateCents        Int
  days                  Int
  totalCents            Int
  currency              String         @db.Char(3)
  /// En régie, `days` est un plafond : seuls les jours des relevés validés sont dus.
  billing               ContractBilling @default(fixed)
  /// Centre de coûts de l'entreprise, libre, pour son imputation comptable.
  costCenter            String?
  /// Le freelance avait déjà été payé par cette entreprise quand le contrat a été créé : sa commission est alors au taux
  /// de fidélité. Figé à la création (déclencheur), donc connu des deux parties avant de signer.
  repeatClient          Boolean        @default(false)
  /// Nom légal, adresse, SIRET, TVA, pays — écrits à la création, jamais modifiés. Base légale de la conservation :
  /// RGPD art. 17(3)(b), obligations comptables.
  sellerSnapshot        Json
  buyerSnapshot         Json
  startsOn              DateTime       @db.Date
  endsOn                DateTime?      @db.Date
  acceptedByFreelanceAt DateTime?      @db.Timestamptz(3)
  acceptedByOrgAt       DateTime?      @db.Timestamptz(3)
  status                ContractStatus @default(pending_signatures)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  quote        Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  organisation Organisation?     @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  profile      FreelanceProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  payments     Payment[]
  invoices     Invoice[]
  review       Review?
  timesheets   Timesheet[]
  approvals    ContractApproval[]
  verifiedMission VerifiedMission?

  /// Cible des clés composées de Payment et Invoice : un paiement ne peut pas être dans une autre devise que son contrat.
  @@unique([id, currency])
  @@index([profileId, status])
  @@index([organisationId, status])
}

model Payment {
  id              String        @id @default(uuid(7)) @db.Uuid
  contractId      String        @db.Uuid
  amountCents     Int
  commissionCents Int
  refundedCents   Int           @default(0)
  currency        String        @db.Char(3)
  /// Identifiant Stripe : unique, pour qu'un même paiement ne soit jamais enregistré deux fois.
  stripeIntentId  String        @unique
  status          PaymentStatus @default(pending)
  /// Virement au compte du freelance, une fois la prestation validée.
  transferId      String?       @unique
  releasedAt      DateTime?     @db.Timestamptz(3)
  /// Réservation d'un versement ou d'un remboursement : posée avant tout appel au prestataire.
  claimedAt       DateTime?     @db.Timestamptz(3)
  /// Litige : un fait, enregistré quel que soit le statut, et qui interdit le versement tant qu'il n'est pas gagné.
  disputeOpenedAt DateTime?     @db.Timestamptz(3)
  disputeWon      Boolean?
  /// À revoir par une personne : litige ou remboursement survenu après le versement, freelance disparu…
  needsReviewAt   DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  contract Contract @relation(fields: [contractId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)

  @@index([contractId])
}

/// Événements Stripe déjà traités. Stripe renvoie chaque événement plusieurs fois, et pas toujours dans l'ordre : le
/// traitement commence par insérer l'événement ici, et s'arrête s'il y était déjà.
/// Relevé mensuel d'un contrat en régie, en demi-journées. Un seul par contrat et par mois ; un relevé refusé peut être
/// corrigé et redéposé, un relevé validé ne change plus (il fonde le paiement et la facture du mois).
model Timesheet {
  id              String          @id @default(uuid(7)) @db.Uuid
  contractId      String          @db.Uuid
  /// Mois couvert, « AAAA-MM ».
  month           String          @db.Char(7)
  halfDays        Int
  note            String?
  status          TimesheetStatus @default(submitted)
  submittedAt     DateTime        @default(now()) @db.Timestamptz(3)
  decidedAt       DateTime?       @db.Timestamptz(3)
  /// Membre de l'entreprise qui a validé ou refusé ; nul s'il a depuis effacé son compte.
  decidedByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  decidedBy User?    @relation("TimesheetDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([contractId, month])
  @@index([status, submittedAt])
}

/// Validation d'une prestation par un administrateur de l'entreprise. Quand l'entreprise exige deux niveaux, la
/// prestation n'est validée (et le versement déclenché) qu'après deux validations de personnes distinctes.
model ContractApproval {
  id         String   @id @default(uuid(7)) @db.Uuid
  contractId String   @db.Uuid
  /// Nul si l'administrateur a depuis effacé son compte : la validation reste un fait daté.
  userId     String?  @db.Uuid
  approvedAt DateTime @default(now()) @db.Timestamptz(3)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([contractId, userId])
  @@index([contractId])
}

/// Clé d'API d'une entreprise, en lecture seule (contrats et factures de mission). Seule l'empreinte SHA-256 est gardée :
/// la clé n'est montrée qu'une fois, à sa création. Une clé révoquée l'est pour toujours (déclencheur).
model ApiKey {
  id              String    @id @default(uuid(7)) @db.Uuid
  organisationId  String    @db.Uuid
  name            String
  /// Début de la clé, affiché pour la reconnaître ; ne suffit pas à s'en servir.
  prefix          String
  hash            String    @unique
  /// Nul si l'administrateur qui l'a créée a depuis effacé son compte.
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt      DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
}

model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([receivedAt])
}

/// Numérotation continue des factures, **par émetteur et par année** : exigée en France, ce qu'une séquence Postgres (qui
/// laisse des trous à chaque annulation) ne garantit pas. Proofseen facture au nom et pour le compte de chaque freelance
/// (mandat de facturation) : chaque freelance a sa propre série, Proofseen la sienne pour ses commissions.
model InvoiceSequence {
  /// Identifiant du profil émetteur, ou « proofseen » pour les factures de commission.
  issuer String
  year   Int
  last   Int    @default(0)

  @@id([issuer, year])
}

enum InvoiceKind {
  mission    // la prestation : émise au nom du freelance, adressée à l'entreprise
  commission // la commission : émise par Proofseen, adressée au freelance
}

/// Une facture émise est immuable : un déclencheur refuse toute modification et toute suppression.
model Invoice {
  id             String      @id @default(uuid(7)) @db.Uuid
  /// Préfixé par l'émetteur : unique sur toute la plateforme, continu dans la série de chaque émetteur.
  number         String      @unique
  kind           InvoiceKind
  issuer         String
  contractId     String      @db.Uuid
  label          String
  netCents       Int
  vatCents       Int
  /// Taux de TVA en points de base (2000 = 20 %).
  vatRateBp      Int
  totalCents     Int
  currency       String      @db.Char(3)
  sellerSnapshot Json
  buyerSnapshot  Json
  issuedAt       DateTime    @default(now()) @db.Timestamptz(3)
  dueOn          DateTime    @db.Date
  /// Une facture de chaque sorte par contrat : un paiement notifié deux fois n'émet jamais deux factures.
  @@unique([contractId, kind])

  contract Contract @relation(fields: [contractId, currency], references: [id, currency], onDelete: Restrict, onUpdate: Restrict)

  @@index([contractId])
}

/// Un avis par contrat, écrit par l'entreprise sur le freelance, après la fin de la mission. Un déclencheur vérifie que le
/// contrat est terminé, que la cible est bien le freelance du contrat et que l'auteur est membre de l'entreprise : pas
/// d'avis libre, pas d'avis acheté, pas dix avis pour une seule mission.
model Review {
  id              String   @id @default(uuid(7)) @db.Uuid
  contractId      String   @unique @db.Uuid
  authorUserId    String?  @db.Uuid
  targetProfileId String   @db.Uuid
  /// Note de 1 à 5. Jamais agrégée dans une colonne du profil ni utilisée pour ordonner une recherche (AI Act).
  rating          Int      @db.SmallInt
  body            String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  contract Contract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  author   User?            @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  target   FreelanceProfile @relation("ReviewTarget", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@index([targetProfileId, createdAt(sort: Desc)])
  @@index([authorUserId], where: raw("\"authorUserId\" IS NOT NULL"), map: "Review_authorUserId_idx")
}

// ─── Mesure de visibilité ───────────────────────────────────────────────────────────────────────────────────────────

/// Demande d'audit reçue avant toute création de compte (formulaire d'inscription).
model AuditRequest {
  id          String   @id @default(uuid(7)) @db.Uuid
  reference   String   @unique
  displayName String
  /// Toujours en minuscules. Sert uniquement à livrer le rapport ; n'entre jamais dans une page publique ni un moteur.
  email       String
  /// Adresses déclarées comme siennes, telles que reçues (1 à 10). Aucune n'est prouvée à ce stade.
  urls        String[]
  lang        String   @db.Char(2)
  consentAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  /// Une demande d'effacement arrive par e-mail : la retrouver ne doit pas parcourir toute la table.
  @@index([email])
}

/// Une vague de mesure. Les réponses brutes restent hors base, chiffrées et purgées à 72 h : on ne garde ici que le résumé.
model Wave {
  id         String   @id @default(uuid(7)) @db.Uuid
  waveId     String   @unique
  profileId  String?  @db.Uuid
  measuredAt DateTime @db.Timestamptz(3)
  draws      Int
  /// Coût réel des appels, s'il est connu : inconnu vaut nul, jamais zéro.
  costCents  Int?
  currency   String?  @db.Char(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  profile     FreelanceProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  results     VisibilityResult[]
  measurement MeasurementRequest?

  @@index([profileId], where: raw("\"profileId\" IS NOT NULL"), map: "Wave_profileId_idx")
}

/// Résultat d'une vague pour un moteur : les comptes de l'entonnoir tels que le rapport client les publie, jamais les
/// réponses brutes (chiffrées et purgées à 72 h, hors base).
model VisibilityResult {
  id        String @id @default(uuid(7)) @db.Uuid
  waveRefId String @db.Uuid
  engine    String
  draws     Int
  /// Tirages où la page du freelance a été retrouvée, nommée, classée dans les cinq premiers, citée de façon certaine.
  retrieved Int
  named     Int
  top5      Int
  cited     Int

  wave Wave @relation(fields: [waveRefId], references: [id], onDelete: Cascade)

  @@unique([waveRefId, engine])
}

/// Où en est une demande de mesure lancée depuis l'application.
enum MeasurementStatus {
  queued  // en file, en attente d'un passage de la tâche planifiée (ou d'un plafond de dépense qui se libère)
  running // prise en charge, sous bail
  done    // vague enregistrée
  failed  // abandonnée après plusieurs essais
  refused // refusée au moment de mesurer : profil dépublié, plus aucune adresse prouvée, aucun moteur configuré
}

/// Une demande de mesure de visibilité faite par le freelance depuis l'application. Elle ne porte aucune réponse de
/// moteur : seulement son état, ce qu'elle a coûté et la vague qu'elle a produite. Les montants sont en centimes de
/// dollar (les fournisseurs facturent en dollars).
model MeasurementRequest {
  id                 String            @id @default(uuid(7)) @db.Uuid
  profileId          String            @db.Uuid
  requestedByUserId  String            @db.Uuid
  status             MeasurementStatus @default(queued)
  /// Moteurs effectivement interrogés, fixés au moment de mesurer : ceux dont la clé est configurée, pas une promesse.
  engines            String[]          @default([])
  attempts           Int               @default(0)
  /// Pas de nouvelle tentative avant cette date (reprise après échec).
  runAfter           DateTime          @default(now()) @db.Timestamptz(3)
  /// Bail de la prise en charge : passé cette date, une autre exécution peut la reprendre.
  leasedUntil        DateTime?         @db.Timestamptz(3)
  /// Plafond dur de la mesure en cours (pire cas), réservé sur les plafonds de la plateforme tant qu'elle tourne.
  estimatedCostCents Int?
  /// Dépense réelle cumulée sur tous les essais ; un essai interrompu sans bilan est compté à son pire cas.
  costCents          Int?
  waveRefId          String?           @unique @db.Uuid
  /// Code d'erreur court, jamais un message de fournisseur.
  errorCode          String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  startedAt          DateTime?         @db.Timestamptz(3)
  finishedAt         DateTime?         @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  profile     FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requestedBy User             @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  wave        Wave?            @relation(fields: [waveRefId], references: [id], onDelete: SetNull)

  /// Une seule demande active par profil, garantie par la base et pas seulement par le code.
  @@unique([profileId], where: raw("\"status\" IN ('queued', 'running')"), map: "MeasurementRequest_active_uq")
  @@index([profileId, createdAt(sort: Desc)])
  @@index([requestedByUserId])
  @@index([runAfter, id], where: raw("\"status\" = 'queued'"), map: "MeasurementRequest_queue_idx")
  @@index([startedAt])
}

/// Registre de dépense des mesures : une ligne par essai pris en charge. Volontairement SANS relation vers un compte
/// ou un profil : effacer un compte ne doit pas effacer ce que la plateforme a dépensé, ni remettre à zéro ses
/// plafonds. La réserve (pire cas) est posée à la prise en charge ; la dépense réelle est réglée à la fin, à l'échec
/// ou à l'expiration du bail (au pire cas). `hostKeys` porte les empreintes des adresses prouvées du profil mesuré
/// (pseudonymes, jamais l'adresse elle-même) : la limite par profil survit ainsi à l'effacement. Gardé 60 jours.
model MeasurementSpend {
  id            String    @id @default(uuid(7)) @db.Uuid
  /// Demande d'origine, sans clé étrangère : la ligne reste quand la demande part avec le compte.
  requestId     String    @db.Uuid
  attempt       Int
  reservedCents Int
  /// Nul tant que l'essai tourne : il compte alors pour sa réserve.
  actualCents   Int?
  hostKeys      String[]  @default([])
  startedAt     DateTime  @db.Timestamptz(3)
  settledAt     DateTime? @db.Timestamptz(3)

  @@unique([requestId, attempt])
  @@index([startedAt])
}

// ─── Notifications ──────────────────────────────────────────────────────────────────────────────────────────────────

enum NotificationKind {
  contact_received     // une entreprise demande le contact (freelance)
  application_received // nouvelle candidature (membres de l'entreprise)
  message_received     // nouveau message dans un fil
  application_status   // la candidature avance (freelance)
  mission_match        // nouvelles missions pour une alerte enregistrée (freelance)
  contract_update      // contrat à signer, actif, prestation validée
  vigilance_expiring   // l'attestation de vigilance URSSAF expire bientôt (freelance)
  mission_confirmation // demande de confirmation reçue (entreprise), confirmée ou refusée (freelance)
  application_read     // la candidature a été ouverte par l'entreprise (freelance)
  mission_invitation   // une entreprise invite à postuler (freelance)
  company_mission      // une entreprise suivie publie une mission (freelance)
  account_notice       // décision d'un opérateur sur le compte ou ses contenus, avec son motif (C19)
}

/// File d'envoi. Écrite dans la même transaction que l'événement : un e-mail n'est jamais perdu parce que l'envoi a
/// échoué, il est réessayé. Le contenu ne porte que des références, **jamais le texte d'un message** : la conversation
/// reste sur la plateforme.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  kind      NotificationKind
  payload   Json
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  /// Prochaine tentative ; repoussée à chaque prise en charge, ce qui sert aussi de bail entre deux processus d'envoi.
  sendAfter DateTime         @default(now()) @db.Timestamptz(3)
  sentAt    DateTime?        @db.Timestamptz(3)
  attempts  Int              @default(0)
  /// Nom de l'erreur seulement : un message d'erreur de fournisseur peut contenir l'adresse du destinataire.
  lastError String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sendAfter], where: raw("\"sentAt\" IS NULL"), map: "Notification_pending_idx")
  @@index([userId, createdAt(sort: Desc)])
}

/// Préférences d'envoi par type. Absence de ligne = envoi activé.
model NotificationPreference {
  userId String           @db.Uuid
  kind   NotificationKind
  email  Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

/// Alerte de missions : les filtres d'une recherche, rejoués pour signaler les nouvelles missions publiées.
model MissionAlert {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @db.Uuid
  filters       Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastCheckedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastCheckedAt])
}

// ─── Limiteur de débit partagé ──────────────────────────────────────────────────────────────────────────────────────

/// Compteur par clé et par fenêtre : tient sur plusieurs instances, contrairement au compteur en mémoire. La clé est un
/// HMAC de l'adresse IP, jamais l'adresse elle-même ; les fenêtres passées sont purgées par une tâche planifiée.
model RateLimitBucket {
  key         String
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// ─── Retours de la bêta ─────────────────────────────────────────────────────────────────────────────────────────────

enum FeedbackKind {
  bug     // quelque chose ne marche pas
  missing // il manque quelque chose
  idea    // une proposition
  other
}

enum FeedbackSide {
  freelance
  company
  visitor
}

/// Où en est un retour, une fois lu par l'opérateur (C19).
enum FeedbackStatus {
  new     // pas encore classé
  planned // retenu, à faire
  done    // fait
  wontfix // écarté
}

/// Un retour laissé pendant la bêta. Classé par nature et par côté, jamais par personne ; l'auteur, s'il est connecté,
/// est rattaché pour pouvoir lui répondre. Son texte peut parler de lui : il part avec son compte, et au bout d'un an.
model Feedback {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String?      @db.Uuid
  kind      FeedbackKind
  side      FeedbackSide
  /// Page d'où vient le retour (chemin seul, sans paramètres).
  page      String?
  body      String
  status     FeedbackStatus @default(new)
  /// Note de l'opérateur sur la suite donnée ; interne.
  triageNote String?
  triagedAt  DateTime?      @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

// ─── Listes de freelances d'une entreprise ──────────────────────────────────────────────────────────────────────────

/// Avis d'un membre de l'entreprise sur un freelance d'une liste : pouce levé ou baissé, rien d'autre.
enum ListReaction {
  up
  down
}

/// Liste de freelances d'une entreprise (favoris, présélection d'une mission), partagée par tous ses membres. Jamais
/// publique, jamais lue par une autre entreprise.
model FreelanceList {
  id              String   @id @default(uuid(7)) @db.Uuid
  organisationId  String   @db.Uuid
  name            String
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// Le créateur peut quitter l'entreprise ou effacer son compte : la liste reste à l'entreprise.
  createdBy    User?               @relation("FreelanceListCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items        FreelanceListItem[]

  @@index([organisationId, createdAt(sort: Desc)])
  @@index([createdByUserId], where: raw("\"createdByUserId\" IS NOT NULL"), map: "FreelanceList_createdByUserId_idx")
}

/// Un freelance dans une liste, avec la note privée de l'entreprise. Le freelance qui efface son compte disparaît de
/// toutes les listes (cascade du profil).
model FreelanceListItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  listId        String   @db.Uuid
  profileId     String   @db.Uuid
  addedByUserId String?  @db.Uuid
  /// Note privée : lue par les seuls membres de l'entreprise, jamais par le freelance ni par une autre entreprise.
  note          String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  list      FreelanceList           @relation(fields: [listId], references: [id], onDelete: Cascade)
  profile   FreelanceProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  addedBy   User?                   @relation("FreelanceListItemAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  reactions FreelanceListReaction[]

  /// Un freelance figure une seule fois dans une liste.
  @@unique([listId, profileId])
  @@index([profileId])
  @@index([addedByUserId], where: raw("\"addedByUserId\" IS NOT NULL"), map: "FreelanceListItem_addedByUserId_idx")
}

/// Le pouce d'un membre sur un freelance d'une liste : un par membre et par ligne. Les compteurs sont calculés à la
/// lecture, dans la liste et pour l'entreprise seulement ; aucun total n'est stocké ni agrégé entre entreprises.
model FreelanceListReaction {
  itemId    String       @db.Uuid
  userId    String       @db.Uuid
  reaction  ListReaction
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  item FreelanceListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([userId])
}

// ─── Blog, guides et études (C18) ───────────────────────────────────────────────────────────────────────────────────

enum ArticleCategory {
  guide
  actualite
  etude
}

enum ArticleAudience {
  freelance
  entreprise
  tous
}

enum ArticleStatus {
  draft
  published
}

/// Un article du blog, écrit par l'opérateur en Markdown (sans HTML brut). Public seulement une fois publié. Ses sources
/// (liste de { title, url }) sont obligatoires dès qu'il contient un chiffre : aucun chiffre sans source.
model Article {
  id          String          @id @default(uuid(7)) @db.Uuid
  /// Unique dans sa langue : la même adresse peut exister en français et en anglais.
  slug        String
  lang        String          @db.Char(2)
  title       String
  description String
  /// Markdown. Le HTML brut est refusé à l'écriture et échappé au rendu.
  body        String
  category    ArticleCategory
  audience    ArticleAudience
  /// Nom affiché de l'auteur, tel qu'il signe l'article.
  authorName  String
  status      ArticleStatus   @default(draft)
  /// Date de première publication ; gardée si l'article est retiré puis republié.
  publishedAt DateTime?       @db.Timestamptz(3)
  /// Liste de { title, url } : les pages officielles d'où viennent les faits de l'article.
  sources     Json            @default("[]")
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([lang, slug])
  /// Les articles publiés d'une langue, des plus récents aux plus anciens.
  @@index([lang, publishedAt(sort: Desc), id(sort: Desc)], where: raw("\"status\" = 'published'"), map: "Article_published_recent_idx")
}

// ─── Profil enrichi et fichiers déposés (C14) ───────────────────────────────────────────────────────────────────────

/// L'usage d'un fichier déposé : chaque usage a ses types et sa taille maximale, vérifiés sur le contenu lui-même.
enum StoredFileKind {
  photo
  cv
  portfolio_image
  message_attachment
}

/// Niveau dans une langue : échelle du Cadre européen commun de référence (CECRL), ou langue maternelle.
enum LanguageLevel {
  a1
  a2
  b1
  b2
  c1
  c2
  native
}

/// Un fichier déposé par une personne, rangé sur le disque du serveur sous son identifiant (tiré au hasard, jamais le
/// nom donné par la personne). Le type est celui reconnu dans le contenu, jamais celui annoncé par le navigateur. La
/// ligne part avec le compte ; le fichier sur disque est effacé par l'application au même moment.
model StoredFile {
  id          String         @id @default(uuid(4)) @db.Uuid
  ownerId     String         @db.Uuid
  kind        StoredFileKind
  contentType String
  size        Int
  /// Empreinte SHA-256 du contenu enregistré, en hexadécimal.
  sha256      String         @db.Char(64)
  width       Int?
  height      Int?
  /// Pièce jointe (C15) : le message qui la porte. Nul le temps de l'envoi, ou si le message a disparu ; une pièce
  /// jointe sans message n'est lisible que par son auteur, puis purgée.
  messageId   String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photoOf     FreelanceProfile? @relation("ProfilePhoto")
  portfolioOf PortfolioItem?
  message     Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ownerId, kind, createdAt(sort: Desc)])
  @@index([messageId], where: raw("\"messageId\" IS NOT NULL"), map: "StoredFile_messageId_idx")
}

/// Une expérience déclarée par le freelance. Déclarée, pas vérifiée : la page publique la sépare des missions vérifiées.
model ProfileExperience {
  id            String    @id @default(uuid(7)) @db.Uuid
  profileId     String    @db.Uuid
  title         String
  company       String?
  /// Le nom de l'entreprise reste privé : la page publique ne l'affiche pas.
  companyHidden Boolean   @default(false)
  /// Premier jour du mois de début.
  startMonth    DateTime  @db.Date
  /// Premier jour du mois de fin ; nul pour une expérience en cours.
  endMonth      DateTime? @db.Date
  description   String?
  skills        String[]
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startMonth(sort: Desc)])
}

model ProfileEducation {
  id        String   @id @default(uuid(7)) @db.Uuid
  profileId String   @db.Uuid
  school    String
  degree    String?
  startYear Int?
  endYear   Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// Une certification déclarée, rattachée à des compétences. L'adresse de vérification n'est publiée que sur un profil
/// nominatif, comme toute adresse web.
model ProfileCertification {
  id            String   @id @default(uuid(7)) @db.Uuid
  profileId     String   @db.Uuid
  name          String
  issuer        String?
  year          Int?
  credentialUrl String?
  skills        String[]
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// Une langue du freelance (code ISO 639-1) et son niveau déclaré : une ligne par langue.
model ProfileLanguage {
  profileId String        @db.Uuid
  code      String        @db.Char(2)
  level     LanguageLevel

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, code])
}

/// Une réalisation du portfolio : un titre, une adresse https (publiée sur un profil nominatif seulement) et une image
/// facultative déposée sur Proofseen.
model PortfolioItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  profileId   String   @db.Uuid
  title       String
  url         String
  description String?
  imageFileId String?  @unique @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  image   StoredFile?      @relation(fields: [imageFileId], references: [id], onDelete: SetNull)

  @@index([profileId])
}

/// Champs proposés par un modèle à partir d'un CV déposé par le freelance. Un brouillon privé : rien n'est publié tant
/// que le freelance n'a pas accepté chaque élément, un par un, et chaque élément est revalidé au moment de l'accepter.
model ProfileImportDraft {
  profileId String   @id @db.Uuid
  proposal  Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Espace missions (C16) ──────────────────────────────────────────────────────────────────────────────────────────

/// Mission enregistrée par une personne pour y revenir. Privée : ni l'entreprise ni personne d'autre ne la voit.
model SavedMission {
  userId    String   @db.Uuid
  jobPostId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@id([userId, jobPostId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([jobPostId])
}

/// Invitation à postuler, envoyée par un membre de l'entreprise à un freelance publié. Une seule par mission et par
/// freelance ; le freelance peut l'écarter. Ce n'est pas une candidature : il décide s'il postule.
model MissionInvitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  jobPostId       String    @db.Uuid
  profileId       String    @db.Uuid
  invitedByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  dismissedAt     DateTime? @db.Timestamptz(3)

  jobPost   JobPost          @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  profile   FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// L'auteur peut quitter l'entreprise ou effacer son compte : l'invitation reste celle de l'entreprise.
  invitedBy User?            @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([jobPostId, profileId])
  @@index([profileId, createdAt(sort: Desc)])
  @@index([jobPostId, createdAt(sort: Desc)])
  @@index([invitedByUserId], where: raw("\"invitedByUserId\" IS NOT NULL"), map: "MissionInvitation_invitedByUserId_idx")
}

/// Entreprise suivie par une personne : une notification à chaque mission qu'elle publie. Seule une entreprise qui a
/// une page publique peut être suivie.
model CompanyFollow {
  userId         String   @db.Uuid
  organisationId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([userId, organisationId])
  @@index([organisationId])
}

/// Modèle de mission d'une entreprise : les champs d'une mission, réutilisables pour en créer une nouvelle. Jamais public.
model MissionTemplate {
  id              String   @id @default(uuid(7)) @db.Uuid
  organisationId  String   @db.Uuid
  createdByUserId String?  @db.Uuid
  name            String
  /// Les champs d'une mission, relus avec le schéma de saisie des missions à chaque usage.
  data            Json
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt(sort: Desc)])
  @@index([createdByUserId], where: raw("\"createdByUserId\" IS NOT NULL"), map: "MissionTemplate_createdByUserId_idx")
}

// ─── Messagerie vivante (C15) ───────────────────────────────────────────────────────────────────────────────────────

/// Jusqu'où une personne a lu un fil : un repère par participant (chaque membre d'une entreprise a le sien). Un message
/// est non lu s'il vient de quelqu'un d'autre et qu'il est postérieur au repère. Le repère ne recule jamais.
model ConversationRead {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

/// Ce que montre le centre de notifications de l'application. Distinct du vocabulaire des e-mails : une mesure terminée
/// se signale dans l'application sans envoyer d'e-mail.
enum AppNotificationKind {
  contact_received
  message_received
  application_received
  application_read
  application_status
  mission_invitation
  mission_confirmation
  contract_update
  measurement_done
}

/// Notification dans l'application, écrite avec l'e-mail correspondant (même transaction), qu'il parte ou non. Comme
/// l'e-mail, elle ne porte que des références : jamais le texte d'un message.
model AppNotification {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @db.Uuid
  kind      AppNotificationKind
  payload   Json
  readAt    DateTime?           @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushQueue PushDelivery[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId], where: raw("\"readAt\" IS NULL"), map: "AppNotification_unread_idx")
  @@index([readAt], where: raw("\"readAt\" IS NOT NULL"), map: "AppNotification_read_idx")
}

/// Résumé quotidien des messages non lus, par e-mail. Désactivé par défaut : la ligne n'existe que si la personne l'a
/// demandé. `lastRunAt` dit quand le résumé du jour a été traité (envoyé, ou rien à dire) : un seul par jour.
model MessageDigest {
  userId    String    @id @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  lastRunAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastRunAt])
}

// ─── Application installable et notifications poussées (C20) ────────────────────────────────────────────────────────
// Un abonnement par appareil (navigateur) qui a accepté les notifications. L'adresse d'envoi est celle d'un service de
// notifications connu (Google, Mozilla, Apple, Microsoft) : jamais une adresse arbitraire que le serveur appellerait.

/// Abonnement d'un appareil aux notifications poussées. `userAgent` est un libellé court (« Chrome · Android »), jamais
/// l'en-tête complet. Sans réussite pendant 90 jours, l'abonnement est purgé ; un 404 ou un 410 du service le supprime.
model PushSubscription {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  failures      Int       @default(0)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([userId])
}

/// Une notification de l'application à pousser vers un appareil. La ligne disparaît une fois poussée, abandonnée, ou
/// devenue sans objet (notification lue entre-temps, compte suspendu, plus d'un jour d'attente).
model PushDelivery {
  id             String   @id @default(uuid(7)) @db.Uuid
  subscriptionId String   @db.Uuid
  notificationId String   @db.Uuid
  attempts       Int      @default(0)
  sendAfter      DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  notification AppNotification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, notificationId])
  @@index([sendAfter])
  @@index([notificationId])
}

// ─── Audience des profils et activité des équipes (C17) ─────────────────────────────────────────────────────────────
// Des totaux par jour (calendrier de Paris), jamais une personne : ni adresse IP, ni identifiant de visiteur, ni nom de
// l'entreprise qui a cherché. Gardés 13 mois, puis purgés par la tâche planifiée.

/// Audience d'un profil, un jour donné : vues de la page publique, apparitions dans la recherche des entreprises et dans
/// l'annuaire public, ajouts à une liste d'entreprise. Un visiteur ne compte qu'une fois par jour et par compteur.
model ProfileStatDay {
  profileId            String   @db.Uuid
  day                  DateTime @db.Date
  views                Int      @default(0)
  searchAppearances    Int      @default(0)
  directoryAppearances Int      @default(0)
  listAdds             Int      @default(0)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, day])
  @@index([day])
}

enum StatKeywordKind {
  skill
  city
}

/// Les filtres (compétence, ville) d'une recherche d'entreprise qui a fait apparaître le profil, comptés par jour sous
/// leur forme normalisée. Vingt au plus par profil et par jour, les plus fréquents. Jamais l'entreprise qui a cherché.
model ProfileStatKeyword {
  profileId   String          @db.Uuid
  day         DateTime        @db.Date
  kind        StatKeywordKind
  keyword     String
  appearances Int             @default(0)

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, day, kind, keyword])
  @@index([day])
}

/// Empreintes du jour, pour ne compter un visiteur qu'une fois : HMAC de l'adresse et du navigateur sous une clé qui
/// change chaque jour. Ni l'adresse ni le navigateur ne sont écrits ; les lignes partent dès le lendemain.
model ProfileStatSeen {
  day        DateTime @db.Date
  profileId  String   @db.Uuid
  /// `view`, `search`, `directory`, ou `keyword:<sorte>:<mot>` pour un filtre de recherche.
  scope      String
  viewerHash String

  profile FreelanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([day, profileId, scope, viewerHash])
  @@index([profileId])
}

/// Activité d'une entreprise, un jour donné : recherches de freelances lancées par ses membres. Le total de l'équipe,
/// jamais par membre.
model OrganisationStatDay {
  organisationId String   @db.Uuid
  day            DateTime @db.Date
  searches       Int      @default(0)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, day])
  @@index([day])
}

// ─── Back-office opérateur (C19) ────────────────────────────────────────────────────────────────────────────────────

/// Ce qu'un opérateur a fait. Vocabulaire fermé : une action nouvelle s'ajoute ici, jamais en texte libre.
enum OperatorActionKind {
  profile_hidden
  profile_restored
  mission_hidden
  mission_restored
  company_page_hidden
  company_page_restored
  contact_cleared
  contact_closed
  vigilance_verified
  vigilance_rejected
  proof_revoked
  registry_rechecked
  user_suspended
  user_restored
  user_exported
  feedback_triaged
  organisation_hidden
  organisation_restored
}

/// Sur quoi porte l'action.
enum OperatorTargetType {
  profile
  mission
  organisation
  conversation
  vigilance
  owned_url
  user
  feedback
}

/// Journal des actions d'opérateur, écrit dans la même transaction que l'action elle-même : une action sans trace ne
/// peut pas exister. Ajout seul : un déclencheur refuse toute modification, et toute suppression avant cinq ans.
/// Volontairement SANS clé étrangère : effacer le compte de l'opérateur ou de la personne visée ne doit pas effacer la
/// preuve de ce qui a été décidé. Le motif est obligatoire pour toute décision qui touche quelqu'un (contrainte en base).
model OperatorAction {
  id             String             @id @default(uuid(7)) @db.Uuid
  operatorUserId String             @db.Uuid
  action         OperatorActionKind
  targetType     OperatorTargetType
  targetId       String             @db.Uuid
  reason         String?
  /// Contexte figé au moment de l'action (référence, adresse, code contrôlé…) ; jamais le texte d'un message.
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([operatorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

/// Décision de l'opérateur sur un premier contact signalé.
enum ContactReviewOutcome {
  ok     // rien à redire
  closed // fil fermé par l'opérateur
}

/// Premier contact d'une entreprise récente, signalé pour relecture. Le message est livré quand même : le signalement ne
/// bloque rien tant que la plateforme n'a pas choisi de retenir ces messages (voir `FIRST_CONTACT_REVIEW`).
model ContactReview {
  id             String                @id @default(uuid(7)) @db.Uuid
  conversationId String                @unique @db.Uuid
  flaggedAt      DateTime              @default(now()) @db.Timestamptz(3)
  reviewedAt     DateTime?             @db.Timestamptz(3)
  outcome        ContactReviewOutcome?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([flaggedAt, id], where: raw("\"reviewedAt\" IS NULL"), map: "ContactReview_pending_idx")
}

/// Trace laissée par l'effacement d'un compte suspendu (revue de sécurité vague 3, L11), pour que la suspension se
/// réapplique si la même adresse revient. Rien d'autre que l'empreinte de l'adresse normalisée (HMAC sous une clé dérivée
/// du secret du serveur, jamais l'adresse), le motif et la date de la suspension. Intérêt légitime ; gardée trois ans.
model ErasureTombstone {
  emailHash        String   @id
  suspendedAt      DateTime @db.Timestamptz(3)
  suspensionReason String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}
